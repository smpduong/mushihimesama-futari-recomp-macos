+// Book I 4.3.2: if an operand is a NaN, the result is the first NaN of FRA, FRB, FRC
+// with its quiet bit set, and fnm* forms do not negate it. An invalid operation with
+// no NaN operand (inf*0, inf-inf) gives the default QNaN, also under fnm*.
+// `result` computes FRT from the locals a_ (FRA), b_ (FRB) and c_ (FRC). The fnm*
+// forms round first and then negate through a volatile; otherwise clang can select
+// FNMADD/FNMSUB, which round the negated value (wrong zero sign, RN 2 and 3).
+static void emit_fused(BuilderContext& ctx, std::string_view result) {
+  ctx.emit_set_flush_mode(false);
+  auto d = ctx.f(ctx.insn.operands[0]);
+  ctx.println("\t{{ const double a_ = {}.f64, b_ = {}.f64, c_ = {}.f64;", ctx.f(ctx.insn.operands[1]),
+              ctx.f(ctx.insn.operands[3]), ctx.f(ctx.insn.operands[2]));
+  ctx.println("\tif (std::isnan(a_) || std::isnan(b_) || std::isnan(c_)) {{");
+  ctx.println("\t\t{}.f64 = std::isnan(a_) ? a_ : std::isnan(b_) ? b_ : c_;", d);
+  ctx.println("\t\t{}.u64 |= 0x0008000000000000ull;", d);
+  ctx.println("\t}} else {{");
+  ctx.println("\t\t{}", fmt::format(fmt::runtime(result), d));
+  ctx.println("\t\tif (std::isnan({}.f64)) {}.u64 = 0x7FF8000000000000ull;", d, d);
+  ctx.println("\t}} }}");
+}
