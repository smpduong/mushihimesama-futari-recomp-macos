+#pragma once
+
+#include <cstdint>
+
+#include <rex/system/xcontent.h>
+
+namespace rex::system::xam {
+
+// Keep title-specific behavior at the content-enumerator call site instead of
+// changing the generic enumerator contract.
+inline constexpr uint32_t kFutariTitleId = 0x435A07D7u;
+
+constexpr bool ShouldUseFutariSavedGameEnumeratorPolicy(uint32_t title_id,
+                                                        uint32_t content_type,
+                                                        bool cvar_enabled) {
+  return cvar_enabled && title_id == kFutariTitleId &&
+         content_type == static_cast<uint32_t>(XContentType::kSavedGame);
+}
+
+}  // namespace rex::system::xam
