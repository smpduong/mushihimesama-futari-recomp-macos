+namespace rex::system::xam {
+// Retain the English preference, but preserve Japanese-only (or other
+// localized) package names. The caller falls back to the file name only
+// when every valid language slot is empty.
+inline std::u16string PackageDisplayName(const rex::filesystem::XContentMetadata& metadata) {
+  const uint32_t count = metadata.metadata_version >= 2
+      ? metadata.kNumLanguagesV2 : metadata.kNumLanguagesV1;
+  for (uint32_t language = 1; language <= count; ++language) {
+    auto name = metadata.display_name(static_cast<rex::system::XLanguage>(language));
+    if (!name.empty()) return name;
+  }
+  return {};
+}
+}  // namespace rex::system::xam
