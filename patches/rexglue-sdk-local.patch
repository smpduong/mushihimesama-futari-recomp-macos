+TEST_CASE("FunctionDispatcher: overlapping recovery preserves the executable",
+          "[runtime][dispatcher][overlay]") {
+  auto& memory = GetTestMemory();
+  rex::runtime::ExportResolver resolver;
+  rex::runtime::FunctionDispatcher dispatcher(&memory, &resolver);
+  constexpr uint32_t base = 0x8A000000;
+  REQUIRE(dispatcher.InitializeFunctionTable(base, 0x10000, base, 0x100000, true));
+  REQUIRE(dispatcher.SetFunction(base + 4, &DummyFn));
+  CHECK(dispatcher.UnregisterModulesOverlappingImageRange(base, 0x100000).empty());
+  CHECK(dispatcher.GetFunction(base + 4) == &DummyFn);
+  CHECK(dispatcher.AllocateThunk(&DummyFn, 0) == base + 0x10000);
+  CHECK_FALSE(dispatcher.InitializeFunctionTable(base, 0x10000, base, 0x100000));
+}
+
+TEST_CASE("FunctionDispatcher: same image A B A clears callbacks and thunks",
+          "[runtime][dispatcher][overlay]") {
+  auto& memory = GetTestMemory();
+  rex::runtime::ExportResolver resolver;
+  rex::runtime::FunctionDispatcher dispatcher(&memory, &resolver);
+  constexpr uint32_t base = 0x8B000000;
+  for (int pass = 0; pass < 6; ++pass) {
+    const uint32_t code = base + (pass % 2 ? 0x20000 : 0x10000);
+    const uint32_t size = pass % 2 ? 0x18000 : 0x10000;
+    REQUIRE(dispatcher.InitializeFunctionTable(code, size, base, 0x100000));
+    dispatcher.RegisterModule(pass % 2 ? "overlayB" : "overlayA", code,
+                              +[](rex::runtime::IModuleRegistrar*) {});
+    // A late callback wasn't part of the registration recording.
+    REQUIRE(dispatcher.SetFunction(code + 8, &DummyFn));
+    const auto thunk = dispatcher.AllocateThunk(&DummyFn, code + 8);
+    REQUIRE(thunk != 0);
+    auto cleared = dispatcher.UnregisterModulesOverlappingImageRange(base, 0x100000);
+    REQUIRE(cleared.size() == 1);
+    CHECK(cleared[0].first == code);
+    CHECK(cleared[0].second == thunk + 4);
+    CHECK(dispatcher.GetFunction(code + 8) == nullptr);
+    CHECK(dispatcher.GetFunction(thunk) == nullptr);
+    CHECK_FALSE(dispatcher.HasAnyFunctionTable());
+  }
+}
+
+TEST_CASE("FunctionDispatcher: orphan table recovery is bounded to overlap",
+          "[runtime][dispatcher][overlay]") {
+  auto& memory = GetTestMemory();
+  rex::runtime::ExportResolver resolver;
+  rex::runtime::FunctionDispatcher dispatcher(&memory, &resolver);
+  constexpr uint32_t base = 0x8C000000;
+  REQUIRE(dispatcher.InitializeFunctionTable(base, 0x10000, base, 0x100000));
+  REQUIRE(dispatcher.SetFunction(base + 4, &DummyFn));
+  CHECK(dispatcher.UnregisterModulesOverlappingImageRange(base, 0).empty());
+  CHECK(dispatcher.UnregisterModulesOverlappingImageRange(base + 0x100000, 4).empty());
+  CHECK(dispatcher.GetFunction(base + 4) == &DummyFn);
+  REQUIRE(dispatcher.UnregisterModulesOverlappingImageRange(base, 4).size() == 1);
+  CHECK(dispatcher.GetFunction(base + 4) == nullptr);
+  CHECK_FALSE(dispatcher.HasAnyFunctionTable());
+}
