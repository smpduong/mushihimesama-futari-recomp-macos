+std::vector<std::pair<uint32_t, uint32_t>> FunctionDispatcher::UnregisterModulesOverlappingImageRange(
+    uint32_t image_base, uint32_t image_size) {
+  std::lock_guard<std::recursive_mutex> lock(dispatch_mutex_);
+  if (image_size == 0) {
+    return {};
+  }
+
+  const uint64_t incoming_end = static_cast<uint64_t>(image_base) + image_size;
+  std::vector<uint32_t> matching_code_bases;
+  matching_code_bases.reserve(module_tables_.size());
+  for (const auto& table : module_tables_) {
+    // The persistent executable is never an overlay recovery candidate.
+    if (table.code_base == entrypoint_code_base_) {
+      continue;
+    }
+    const uint64_t table_end = static_cast<uint64_t>(table.image_base) + table.image_size;
+    if (table.image_base < incoming_end && static_cast<uint64_t>(image_base) < table_end) {
+      matching_code_bases.push_back(table.code_base);
+    }
+  }
+
+  if (matching_code_bases.empty()) {
+    return {};
+  }
+
+  std::vector<std::pair<uint32_t, uint32_t>> cleared_ranges;
+  for (const uint32_t code_base : matching_code_bases) {
+    std::string module_id;
+    for (const auto& [id, reg] : module_addresses_) {
+      if (reg.code_base == code_base) {
+        module_id = id;
+        break;
+      }
+    }
+
+    if (!module_id.empty()) {
+      if (auto range = UnregisterModule(module_id)) {
+        cleared_ranges.push_back(*range);
+      }
+      continue;
+    }
+
+    auto table_it = std::find_if(module_tables_.begin(), module_tables_.end(),
+                                 [code_base](const ModuleTableInfo& table) {
+                                   return table.code_base == code_base;
+                                 });
+    if (table_it == module_tables_.end()) {
+      continue;
+    }
+
+    REXLOG_WARN(
+        "UnregisterModulesOverlappingImageRange: purging unregistered table at code={:08X}",
+        code_base);
+
+    const uint32_t table_start = table_it->code_base;
+    const uint32_t table_end = table_start + table_it->code_size;
+    const uint32_t pool_start = table_it->code_base + table_it->code_size;
+    const uint32_t pool_end = table_it->next_thunk_address;
+    for (uint32_t addr = table_it->code_base; addr < table_end; addr += 4) {
+      function_table_.erase(addr);
+      memory_->SetFunction(addr, nullptr);
+    }
+    for (uint32_t addr = pool_start; addr < pool_end; addr += 4) {
+      function_table_.erase(addr);
+      memory_->SetFunction(addr, nullptr);
+    }
+    cleared_ranges.emplace_back(table_start, pool_end);
+
+    if (table_it->code_base == entrypoint_code_base_) {
+      entrypoint_code_base_ = 0;
+    }
+    memory_->DestroyFunctionTable(code_base);
+    module_tables_.erase(table_it);
+  }
+
+  return cleared_ranges;
+}
+
 }  // namespace rex::runtime
